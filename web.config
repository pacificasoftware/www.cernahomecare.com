<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- Redirect old Cerna domain to new domain -->
        <rule name="RedirectCernaLegacyDomain" stopProcessing="true">
          <match url="(.*)" />

          <conditions>
            <add input="{HTTP_HOST}"
                 pattern="^(www\.)?cernahc\.com$"
                 ignoreCase="true" />
          </conditions>

          <action
            type="Redirect"
            url="https://www.cernahomecare.com/{R:1}"
            appendQueryString="true"
            redirectType="Permanent" />
        </rule>

        <!-- Existing Next.js reverse proxy -->
        <rule name="ReverseProxyInboundRule1" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3020/{R:1}" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
